{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".read": "auth.uid === 'ADMIN_UID'",
      "$uid": {
        ".write": "auth.uid === $uid && !data.exists()",
        ".validate": "newData.hasChildren(['t','v']) && newData.child('t').isNumber() && newData.child('v').isNumber() && newData.child('t').val() <= now + 60000 && newData.child('t').val() >= now - 86400000",
        "t": {}, "v": {},
        "$o": { ".validate": false }
      }
    },
    "dau": {
      ".read": "auth.uid === 'ADMIN_UID'",
      "$day": {
        ".validate": "$day.matches(/^\\d{4}-\\d{2}-\\d{2}$/)",
        "$uid": { ".write": "auth.uid === $uid && !data.exists()", ".validate": "newData.val() === true" }
      }
    },
    "ads": {
      ".read": "auth != null",
      ".write": "auth.uid === 'ADMIN_UID'",
      "$id": {
        ".validate": "newData.hasChildren(['title','max','views','on'])",
        "title": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
        "text": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "img": { ".validate": "newData.isString() && newData.val().matches(/^https:\\/\\/[^ \"'<>]{4,500}$/)" },
        "vid": { ".validate": "newData.isString() && newData.val().matches(/^https:\\/\\/[^ \"'<>]{4,500}$/)" },
        "link": { ".validate": "newData.isString() && newData.val().matches(/^https:\\/\\/[^ \"'<>]{4,500}$/)" },
        "max": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 10000000" },
        "on": { ".validate": "newData.isBoolean()" },
        "t": { ".validate": "newData.isNumber()" },
        "views": {
          ".write": "auth != null && newData.isNumber() && newData.val() === data.val() + 1 && newData.val() <= root.child('ads').child($id).child('max').val() && !root.child('adseen').child($id).child(auth.uid).exists()",
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "clicks": {
          ".write": "auth != null && newData.isNumber() && newData.val() === data.val() + 1 && !root.child('adclick').child($id).child(auth.uid).exists()",
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "$o": { ".validate": false }
      }
    },
    "adseen": {
      ".read": "auth.uid === 'ADMIN_UID'",
      "$id": { "$uid": { ".write": "auth.uid === $uid && !data.exists()", ".validate": "newData.val() === true" } }
    },
    "adclick": {
      ".read": "auth.uid === 'ADMIN_UID'",
      "$id": { "$uid": { ".write": "auth.uid === $uid && !data.exists()", ".validate": "newData.val() === true" } }
    }
  }
}
